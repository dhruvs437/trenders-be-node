# Copy to .env and fill in. Never commit .env.
PORT=8000
NODE_ENV=development

# MongoDB Atlas connection string (db name: trenders)
DATABASE=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trenders?retryWrites=true&w=majority

# JWT signing secret. Generate one with: openssl rand -hex 32
SECRET_KEY=

# Frontend origin allowed by CORS (comma-separated if several)
CLIENT_ORIGIN=http://localhost:3000

# Razorpay (test mode keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend (for OTP emails) - dashboard.resend.com/api-keys
RESEND_API_KEY=
# defaults to onboarding@resend.dev (only delivers to your own Resend
# account email until you verify a domain you own)
RESEND_FROM_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
