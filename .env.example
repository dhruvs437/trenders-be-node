# Copy to .env and fill in. Never commit .env.
PORT=8000
NODE_ENV=development

# MongoDB Atlas connection string (db name: trenders)
DATABASE=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trenders?retryWrites=true&w=majority

# JWT signing secret. Generate one with: openssl rand -hex 32
SECRET_KEY=

# Frontend origin allowed by CORS (comma-separated if several)
CLIENT_ORIGIN=http://localhost:3000

# Razorpay (test mode keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gmail API (for OTP emails) - sends via a real Gmail account over HTTPS,
# so it isn't subject to SMTP-port blocking and can send to any recipient.
# Set up: Google Cloud Console project > enable Gmail API > OAuth consent
# screen (External, Testing) > OAuth client (Web app) > authorize once via
# https://developers.google.com/oauthplayground to get a refresh token.
MY_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
